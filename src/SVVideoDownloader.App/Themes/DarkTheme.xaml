<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AppBackgroundColor">#0D111A</Color>
    <Color x:Key="HeaderBackgroundColor">#111723</Color>
    <Color x:Key="SurfaceColor">#151C29</Color>
    <Color x:Key="SurfaceElevatedColor">#1B2433</Color>
    <Color x:Key="InputBackgroundColor">#101722</Color>
    <Color x:Key="BorderColor">#2B3649</Color>
    <Color x:Key="BorderStrongColor">#43516A</Color>
    <Color x:Key="TextPrimaryColor">#F4F7FC</Color>
    <Color x:Key="TextSecondaryColor">#A5B1C5</Color>
    <Color x:Key="TextTertiaryColor">#7E8CA4</Color>
    <Color x:Key="AccentColor">#8B7DFF</Color>
    <Color x:Key="AccentHoverColor">#9E93FF</Color>
    <Color x:Key="AccentPressedColor">#7464EE</Color>
    <Color x:Key="AccentSoftColor">#2B2850</Color>
    <Color x:Key="AccentTextColor">#C4BCFF</Color>
    <Color x:Key="ButtonBackgroundColor">#202A3B</Color>
    <Color x:Key="ButtonHoverColor">#2A364A</Color>
    <Color x:Key="ButtonPressedColor">#344258</Color>
    <Color x:Key="ProgressTrackColor">#303B4E</Color>
    <Color x:Key="WarningSurfaceColor">#342C18</Color>
    <Color x:Key="WarningBorderColor">#7E682E</Color>
    <Color x:Key="WarningTextColor">#FFD778</Color>
    <Color x:Key="ErrorSurfaceColor">#351C25</Color>
    <Color x:Key="ErrorBorderColor">#7E3B4A</Color>
    <Color x:Key="ErrorTextColor">#FFABB9</Color>
    <Color x:Key="InfoSurfaceColor">#172A45</Color>
    <Color x:Key="InfoBorderColor">#315B88</Color>
    <Color x:Key="InfoTextColor">#9CC7FF</Color>
    <Color x:Key="SuccessSurfaceColor">#173329</Color>
    <Color x:Key="SuccessBorderColor">#2F7358</Color>
    <Color x:Key="SuccessTextColor">#7EE0B5</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="{StaticResource HeaderBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{StaticResource ButtonBackgroundColor}" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="{StaticResource ButtonHoverColor}" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="{StaticResource ButtonPressedColor}" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="{StaticResource ProgressTrackColor}" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="{StaticResource WarningSurfaceColor}" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="{StaticResource WarningBorderColor}" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="{StaticResource WarningTextColor}" />
    <SolidColorBrush x:Key="ErrorSurfaceBrush" Color="{StaticResource ErrorSurfaceColor}" />
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="{StaticResource ErrorBorderColor}" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="{StaticResource ErrorTextColor}" />
    <SolidColorBrush x:Key="InfoSurfaceBrush" Color="{StaticResource InfoSurfaceColor}" />
    <SolidColorBrush x:Key="InfoBorderBrush" Color="{StaticResource InfoBorderColor}" />
    <SolidColorBrush x:Key="InfoTextBrush" Color="{StaticResource InfoTextColor}" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="{StaticResource SuccessSurfaceColor}" />
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="{StaticResource SuccessBorderColor}" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="{StaticResource SuccessTextColor}" />

    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{StaticResource InputBackgroundColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
</ResourceDictionary>

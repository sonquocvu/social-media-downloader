<Window x:Class="SVVideoDownloader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SV Video Downloader — Tải video"
        Width="1180"
        Height="800"
        MinWidth="920"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="14"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <Window.Resources>
        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="Padding" Value="20" />
            <Setter Property="Background"
                    Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0F6CBD" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#0B5794" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <TabControl KeyboardNavigation.TabNavigation="Continue">
        <TabItem Header="_Tải xuống">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Focusable="False">
        <Grid Margin="28" MinWidth="840">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock FontSize="28"
                           FontWeight="SemiBold"
                           Text="Tải video bạn có quyền sử dụng" />
                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource SecondaryText}"
                           Text="Hỗ trợ liên kết công khai từ YouTube, TikTok và Facebook." />
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,18,0,0"
                    Padding="14"
                    Background="#FFF4CE"
                    BorderBrush="#D6B656"
                    BorderThickness="1"
                    CornerRadius="6">
                <TextBlock Foreground="#242424"
                           Text="Chỉ tải nội dung do bạn sở hữu hoặc được phép tải. Ứng dụng không vượt DRM, tường phí, CAPTCHA, giới hạn địa lý hoặc truy cập tài khoản trái phép."
                           TextWrapping="Wrap" />
            </Border>

            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="480" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="2*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SectionBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock FontSize="19"
                                   FontWeight="SemiBold"
                                   Text="Phân tích video" />

                        <Grid Grid.Row="1" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Padding="0,0,0,6"
                                       Target="{Binding ElementName=UrlInput}"
                                       Content="Liên kết video" />
                                <TextBox x:Name="UrlInput"
                                         AutomationProperties.Name="Liên kết video"
                                         Text="{Binding VideoUrl, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Dán liên kết HTTPS công khai từ nền tảng được hỗ trợ" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Margin="10,27,0,0"
                                    MinWidth="70"
                                    Command="ApplicationCommands.Paste"
                                    CommandTarget="{Binding ElementName=UrlInput}"
                                    Content="_Dán"
                                    AutomationProperties.Name="Dán liên kết" />
                            <Button Grid.Column="2"
                                    Margin="10,27,0,0"
                                    MinWidth="108"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding AnalyzeCommand}"
                                    Content="_Phân tích"
                                    AutomationProperties.HelpText="Kiểm tra liên kết và lấy thông tin video" />
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,18,0,0" MinHeight="165">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsAnalysisEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Text="Chưa có video" />
                                <TextBlock Margin="0,7,0,0"
                                           MaxWidth="470"
                                           TextAlignment="Center"
                                           Style="{StaticResource SecondaryText}"
                                           Text="{Binding AnalysisMessage}" />
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ProgressBar Width="220"
                                             Height="8"
                                             IsIndeterminate="True"
                                             AutomationProperties.Name="Đang phân tích video" />
                                <TextBlock Margin="0,12,0,0"
                                           Text="{Binding AnalysisMessage}"
                                           TextAlignment="Center" />
                            </StackPanel>

                            <Border Padding="16"
                                    Background="#FDE7E9"
                                    BorderBrush="#C50F1F"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasAnalysisError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="#8A0010"
                                               Text="Không thể phân tích video" />
                                    <TextBlock Margin="0,6,0,0"
                                               Foreground="#5C0010"
                                               Text="{Binding AnalysisMessage}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Grid Visibility="{Binding IsAnalysisSuccessful, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="240"
                                        Height="135"
                                        Background="#E1E1E1"
                                        BorderBrush="#A0A0A0"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        ClipToBounds="True">
                                    <Grid>
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#555555"
                                                   Text="Không có ảnh thu nhỏ" />
                                        <Image Source="{Binding ThumbnailUri}"
                                               Stretch="UniformToFill"
                                               AutomationProperties.Name="Ảnh thu nhỏ của video" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock FontSize="18"
                                               FontWeight="SemiBold"
                                               MaxHeight="54"
                                               Text="{Binding VideoTitle}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="Wrap"
                                               ToolTip="{Binding VideoTitle}" />
                                    <TextBlock Margin="0,12,0,0">
                                        <Run FontWeight="SemiBold" Text="Nguồn: " />
                                        <Run Text="{Binding VideoSource, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Margin="0,6,0,0">
                                        <Run FontWeight="SemiBold" Text="Thời lượng: " />
                                        <Run Text="{Binding VideoDuration, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Margin="0,10,0,0"
                                               FontSize="12"
                                               Style="{StaticResource SecondaryText}"
                                               Text="{Binding AnalysisMessage}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock FontSize="19"
                                   FontWeight="SemiBold"
                                   Text="Tùy chọn tải xuống" />

                        <Label Margin="0,16,0,0"
                               Padding="0,0,0,6"
                               Target="{Binding ElementName=QualitySelector}"
                               Content="Chất lượng" />
                        <ComboBox x:Name="QualitySelector"
                                  ItemsSource="{Binding QualityOptions}"
                                  SelectedItem="{Binding SelectedQuality}"
                                  DisplayMemberPath="DisplayName"
                                  AutomationProperties.Name="Chọn chất lượng" />

                        <Label Margin="0,14,0,0"
                               Padding="0,0,0,6"
                               Target="{Binding ElementName=OutputFolderInput}"
                               Content="Thư mục lưu" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputFolderInput"
                                     IsReadOnly="True"
                                     Text="{Binding OutputFolder}"
                                     ToolTip="{Binding OutputFolder}"
                                     AutomationProperties.Name="Thư mục lưu tệp" />
                            <Button Grid.Column="1"
                                    Margin="9,0,0,0"
                                    Command="{Binding BrowseOutputFolderCommand}"
                                    Content="_Chọn…"
                                    AutomationProperties.Name="Chọn thư mục lưu" />
                        </Grid>

                        <CheckBox Margin="0,18,0,0"
                                  IsChecked="{Binding RightsConfirmed}"
                                  VerticalContentAlignment="Top"
                                  AutomationProperties.Name="Xác nhận quyền tải nội dung">
                            <TextBlock MaxWidth="330"
                                       Text="Tôi xác nhận mình sở hữu nội dung hoặc được phép tải nội dung này."
                                       TextWrapping="Wrap" />
                        </CheckBox>

                        <TextBlock Margin="0,10,0,0"
                                   Foreground="#B10E1E"
                                   Text="{Binding FolderErrorMessage}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasFolderError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <TextBlock Margin="0,8,0,0"
                                   Foreground="#B10E1E"
                                   Text="{Binding SettingsMessage}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasSettingsMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <Button Margin="0,18,0,0"
                                MinHeight="42"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding DownloadCommand}"
                                Content="_Tải xuống"
                                AutomationProperties.HelpText="Thêm video vào hàng đợi tải xuống" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="3"
                    Margin="0,20,0,28"
                    Style="{StaticResource SectionBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock FontSize="19"
                               FontWeight="SemiBold"
                               Text="Hàng đợi tải xuống" />

                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <TextBlock Padding="12,28"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource SecondaryText}"
                                   Text="Chưa có tác vụ tải xuống."
                                   Visibility="{Binding IsQueueEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <ListBox MaxHeight="470"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ItemsSource="{Binding DownloadQueue}"
                                 KeyboardNavigation.TabNavigation="Continue"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Visibility="{Binding HasQueueItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,10" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="14"
                                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold"
                                                               Text="{Binding Title}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Title}" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               FontSize="12"
                                                               Style="{StaticResource SecondaryText}"
                                                               Text="{Binding SourceText}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Margin="16,0,0,0"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding StatusText}" />
                                            </Grid>

                                            <ProgressBar Grid.Row="1"
                                                         Margin="0,12,0,0"
                                                         Height="9"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Value="{Binding PercentageValue}"
                                                         IsIndeterminate="{Binding IsProgressIndeterminate}"
                                                         AutomationProperties.Name="Tiến độ tải xuống" />

                                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock>
                                                    <Run Text="Tiến độ: " />
                                                    <Run Text="{Binding PercentageText, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Grid.Column="1" Margin="22,0,0,0">
                                                    <Run Text="Đã tải: " />
                                                    <Run Text="{Binding DownloadedSizeText, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" Margin="22,0,0,0">
                                                    <Run Text="Tốc độ: " />
                                                    <Run Text="{Binding SpeedText, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Grid.Column="3" Margin="22,0,0,0">
                                                    <Run Text="Còn lại: " />
                                                    <Run Text="{Binding EtaText, Mode=OneWay}" />
                                                </TextBlock>
                                            </Grid>

                                            <Grid Grid.Row="3" Margin="0,11,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Foreground="#B10E1E"
                                                           Text="{Binding ErrorMessage}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock Foreground="#B10E1E"
                                                           Text="{Binding ActionMessage}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding HasActionMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <WrapPanel Grid.Row="1" Margin="0,9,0,0">
                                                    <Button Margin="0,0,8,6"
                                                            Command="{Binding CancelCommand}"
                                                            Content="_Hủy" />
                                                    <Button Margin="0,0,8,6"
                                                            Command="{Binding RetryCommand}"
                                                            Content="Thử _lại" />
                                                    <Button Margin="0,0,8,6"
                                                            Command="{Binding RemoveCommand}"
                                                            Content="_Xóa mục đã xong" />
                                                    <Button Margin="0,0,8,6"
                                                            Command="{Binding OpenFileCommand}"
                                                            Content="_Mở tệp" />
                                                    <Button Margin="0,0,8,6"
                                                            Command="{Binding OpenFolderCommand}"
                                                            Content="Mở thư _mục" />
                                                </WrapPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="_Lịch sử">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <Grid Margin="28" MinWidth="760">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="26"
                                       FontWeight="SemiBold"
                                       Text="Lịch sử tải xuống" />
                            <TextBlock Margin="0,7,0,0"
                                       Style="{StaticResource SecondaryText}"
                                       Text="Lịch sử chỉ lưu thông tin tác vụ đã hoàn tất trên máy này." />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Margin="18,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding ClearHistoryCommand}"
                                Content="_Xóa lịch sử"
                                ToolTip="Không xóa các tệp video đã tải" />
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,18,0,0"
                            Padding="13"
                            Background="#E8F3FF"
                            BorderBrush="#5B9BD5"
                            BorderThickness="1"
                            CornerRadius="6">
                        <TextBlock Foreground="#17365D"
                                   Text="Xóa lịch sử hoặc xóa mục khỏi hàng đợi không bao giờ xóa tệp video đã tải."
                                   TextWrapping="Wrap" />
                    </Border>

                    <Grid Grid.Row="2" Margin="0,18,0,28">
                        <StackPanel HorizontalAlignment="Center"
                                    Margin="0,35"
                                    Visibility="{Binding IsHistoryEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Text="Chưa có lịch sử tải xuống" />
                            <TextBlock Margin="0,7,0,0"
                                       Style="{StaticResource SecondaryText}"
                                       Text="Các tác vụ hoàn tất sẽ xuất hiện tại đây." />
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasHistoryItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding DownloadHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10"
                                                Padding="14"
                                                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold"
                                                               Text="{Binding Title}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Title}" />
                                                    <WrapPanel Margin="0,6,0,0">
                                                        <TextBlock Margin="0,0,18,0">
                                                            <Run Text="Nguồn: " />
                                                            <Run Text="{Binding SourceText, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Margin="0,0,18,0">
                                                            <Run Text="Chất lượng: " />
                                                            <Run Text="{Binding QualityText, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock>
                                                            <Run Text="Hoàn tất: " />
                                                            <Run Text="{Binding CompletedAtText, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </WrapPanel>
                                                    <TextBlock Margin="0,6,0,0"
                                                               FontSize="12"
                                                               Style="{StaticResource SecondaryText}"
                                                               Text="{Binding FilePath}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,6,0,0"
                                                               Foreground="#B10E1E"
                                                               Text="{Binding ActionMessage}"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding HasActionMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                                <WrapPanel Grid.Column="1"
                                                           Margin="18,0,0,0"
                                                           VerticalAlignment="Center">
                                                    <Button Margin="0,0,8,0"
                                                            Command="{Binding OpenFileCommand}"
                                                            Content="_Mở tệp" />
                                                    <Button Command="{Binding OpenFolderCommand}"
                                                            Content="Mở thư _mục" />
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Margin="0,0,0,12"
                                   Foreground="#0B6A0B"
                                   Text="{Binding HistoryMessage}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Bottom"
                                   Visibility="{Binding HasHistoryMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="_Công cụ và cài đặt">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <Grid Margin="28" MinWidth="760">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="26"
                                       FontWeight="SemiBold"
                                       Text="Trạng thái công cụ" />
                            <TextBlock Margin="0,7,0,0"
                                       Style="{StaticResource SecondaryText}"
                                       Text="Kiểm tra yt-dlp, FFmpeg và ffprobe trong dữ liệu cục bộ của ứng dụng." />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Margin="18,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding RefreshToolsCommand}"
                                Content="_Kiểm tra lại" />
                    </Grid>

                    <ItemsControl Grid.Row="1"
                                  Margin="0,18,0,0"
                                  ItemsSource="{Binding ToolStatuses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10"
                                        Padding="14"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding Name}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding StatusText}" />
                                            <TextBlock Margin="0,4,0,0">
                                                <Run Text="Phiên bản: " />
                                                <Run Text="{Binding VersionText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Margin="18,0,0,0"
                                                   Text="{Binding ExecutablePath}"
                                                   TextWrapping="Wrap"
                                                   ToolTip="{Binding ExecutablePath}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Grid.Row="2"
                            Margin="0,10,0,28"
                            Style="{StaticResource SectionBorder}">
                        <StackPanel>
                            <TextBlock FontSize="19"
                                       FontWeight="SemiBold"
                                       Text="Cập nhật yt-dlp thủ công" />
                            <TextBlock Margin="0,9,0,0"
                                       Style="{StaticResource SecondaryText}"
                                       Text="Chỉ cập nhật khi bạn bấm nút. Ứng dụng tải yt-dlp.exe và SHA2-256SUMS từ bản phát hành ổn định chính thức, kiểm tra SHA-256, xác minh executable, rồi thay thế nguyên tử. Nếu bản mới không chạy, ứng dụng thử khôi phục bản cũ."
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="#7A4E00"
                                       Text="Không thể cập nhật trong lúc đang phân tích hoặc tải video. Ứng dụng không tự nhập cookie trình duyệt và không cập nhật ngầm."
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,12,0,0"
                                       Text="{Binding ToolsMessage}"
                                       TextWrapping="Wrap" />
                            <Button Margin="0,15,0,0"
                                    HorizontalAlignment="Left"
                                    MinWidth="190"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding UpdateYtDlpCommand}"
                                    Content="_Cập nhật yt-dlp" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>

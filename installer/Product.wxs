<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
    Id="*"
    Name="SV Video Downloader"
    Language="1066"
    Codepage="65001"
    Version="$(var.ProductVersion)"
    Manufacturer="SVVideoDownloader"
    UpgradeCode="{75798F98-7518-4F21-9BFB-338F9BF16BF1}">

    <Package
      Id="*"
      Description="SV Video Downloader"
      InstallerVersion="500"
      InstallPrivileges="elevated"
      InstallScope="perMachine"
      Platform="x64"
      Compressed="yes"
      SummaryCodepage="1252" />

    <MajorUpgrade
      Schedule="afterInstallInitialize"
      DowngradeErrorMessage="Đã cài đặt phiên bản [ProductName] mới hơn." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon
      Id="AppIcon"
      SourceFile="$(var.RepositoryRoot)\src\SVVideoDownloader.App\Assets\SVVideoDownloader.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="SVVideoDownloader" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="SV Video Downloader" />
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component
        Id="ApplicationExecutableComponent"
        Guid="{4DAAA4B3-6135-48A0-B805-59FD17137D53}"
        Win64="yes">
        <File
          Id="ApplicationExecutable"
          Source="$(var.PublishDir)\SVVideoDownloader.App.exe"
          Name="SVVideoDownloader.App.exe"
          KeyPath="yes"
          Checksum="yes">
          <Shortcut
            Id="StartMenuShortcut"
            Directory="ApplicationProgramsFolder"
            Name="SV Video Downloader"
            Description="Tải video công khai được phép"
            WorkingDirectory="INSTALLFOLDER"
            Icon="AppIcon"
            Advertise="no" />
          <Shortcut
            Id="DesktopShortcut"
            Directory="DesktopFolder"
            Name="SV Video Downloader"
            Description="Tải video công khai được phép"
            WorkingDirectory="INSTALLFOLDER"
            Icon="AppIcon"
            Advertise="no" />
        </File>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component
        Id="ApplicationProgramsFolderComponent"
        Guid="{732C8E31-36C4-428B-8543-57AEB97FE433}"
        Win64="yes">
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue
          Root="HKLM"
          Key="Software\SVVideoDownloader"
          Name="Installed"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="ProductFeature" Title="SV Video Downloader" Level="1">
      <ComponentRef Id="ApplicationExecutableComponent" />
      <ComponentRef Id="ApplicationProgramsFolderComponent" />
    </Feature>
  </Product>
</Wix>
